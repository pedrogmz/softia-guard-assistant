# --- Backend local (Ollama + RAG). Copia este archivo a .env y ajusta si hace falta. ---

# Host donde corre Ollama. En local: http://localhost:11434
# En docker-compose (servicio "ollama"): http://ollama:11434
OLLAMA_HOST=http://localhost:11434

# Modelo LLM local (descargar con: ollama pull qwen2.5:7b-instruct)
# Alternativa: llama3.1:8b
LLM_MODEL=qwen2.5:7b-instruct

# Modelo de embeddings multilingüe (descargar con: ollama pull bge-m3)
EMBED_MODEL=bge-m3

# Carpeta donde ChromaDB persiste el vector store
CHROMA_DIR=./chroma_db

# Nº de fragmentos de políticas recuperados por consulta
RAG_TOP_K=3

# Soft-IA: id del condominio destino (campo idcondominios del QR y de la sync). Opcional.
# Si se define, se rechazan códigos QR de otro condominio y es el condominio que se sincroniza.
CONDOMINIO_ID=

# --- Sincronización con Soft-IA (alimenta apartments.json e invitations.json) ---
# Deshabilitada por defecto; los datos quedan en local para operar sin conexión constante.
SOFTIA_ENABLED=false
SOFTIA_BASE_URL=https://php.apiq-soft-ia.orb.local
SOFTIA_SYNC_INTERVAL=300           # segundos entre sincronizaciones
SOFTIA_VERIFY_TLS=false            # off en local orb.local; true en producción
# Login (usuario+contraseña -> token). Ajusta la ruta/campos si difieren.
SOFTIA_LOGIN_PATH=/api/login_check
SOFTIA_USERNAME=
SOFTIA_PASSWORD=
SOFTIA_USERNAME_FIELD=username
SOFTIA_PASSWORD_FIELD=password
SOFTIA_TOKEN_FIELD=token
# Rutas de datos ({id} = idcondominio)
SOFTIA_PROPIETARIOS_PATH=/api/condominio/{id}/propietarios
SOFTIA_AUTORIZACIONES_PATH=/api/condominio/{id}/autorizaciones
# Registro de visitas (RF-14): el acceso autorizado se registra de vuelta en Soft-IA.
SOFTIA_VISITAS_PATH=/api/condominio/{id}/visitas
SOFTIA_AUTORIZADO_POR=Vigilante Virtual
# Actualización de una autorización (completar cedula/telefono faltantes).
SOFTIA_AUTORIZACION_ITEM_PATH=/api/condominio/{id}/autorizaciones/{auth}
SOFTIA_UPDATE_METHOD=PATCH
# Solicitudes de acceso por WhatsApp vía Soft-IA ({sol} = idsolicitud). Contrato propuesto.
SOFTIA_SOLICITUDES_PATH=/api/condominio/{id}/solicitudes-acceso
SOFTIA_SOLICITUD_ITEM_PATH=/api/condominio/{id}/solicitudes-acceso/{sol}
# true = simula a Soft-IA/WhatsApp (responder con POST /api/dev/access-request/{id}/respond)
SOFTIA_SOLICITUD_MOCK=true
ACCESS_REQUEST_TIMEOUT_S=120       # segundos que el visitante espera la respuesta del propietario
ACCESS_REQUEST_POLL_MIN_S=3        # intervalo mínimo entre consultas a Soft-IA

# --- STT local (Whisper vía faster-whisper) ---
# Tamaño del modelo: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# cpu (Apple Silicon) o cuda (GPU NVIDIA en Linux)
WHISPER_DEVICE=cpu
# int8 (cpu) o float16 (cuda)
WHISPER_COMPUTE_TYPE=int8
# Idioma del reconocimiento (vacío = autodetectar)
WHISPER_LANGUAGE=es

# Puerto del backend
PORT=8000
